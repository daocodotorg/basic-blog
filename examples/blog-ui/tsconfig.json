{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ES2023", "dom", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "noEmit": true
  },
  "include": ["./src/**/*"]
}
